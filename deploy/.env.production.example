# PgCloudDoc 生产环境变量模板。
#
# 不要手工复制！运行 `node deploy/deploy.mjs`（或 pnpm deploy:prod）时，
# 脚本会把它生成为 deploy/.env.production，并把所有 <generate> 替换成随机密钥。
#
# 生成之后这个文件就归你管了：改密码、改域名、开 HTTPS 都在这里。
# 它已在 .gitignore 里，不会进版本库。

# ── PostgreSQL ──
# 密码只用字母数字和 -_ ：它会原样拼进 DATABASE_URL（postgresql://user:pass@host/db），
# 带 @ : / ? 等字符会把连接串拆坏。脚本自动生成的正是这种格式。
POSTGRES_USER=pgclouddoc
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=pgclouddoc

# ── Redis ──
# 留空 = 不设密码（不推荐，生产必须设）
REDIS_PASSWORD=<generate>

# ── 认证 ──
# 至少 16 位；修改后已签发的 token 全部失效
JWT_ACCESS_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>

# ── 对外访问 ──
# 浏览器实际访问的地址（含协议，不带结尾斜杠）。
# 决定 CORS 白名单、OAuth 回调，以及——用 HTTPS 时——cookie 的 Secure 标记。
PUBLIC_ORIGIN=http://localhost
WEB_PORT=80

# 走 HTTPS 时必须改成 true，否则 httpOnly 的 refresh cookie 不会带上 Secure
COOKIE_SECURE=false

# ── 可选 ──
LOG_LEVEL=info
KAFKA_EXTERNAL_PORT=9094

# ── 配置中心（etcd）──
# 留空 ETCD_ENDPOINTS = 关闭配置中心：前端拿到空配置，后台接口 503。
# 按环境分前缀，避免和开发/其它环境共用同一个 etcd 时互相覆盖
ETCD_ENDPOINTS=etcd:2379
ETCD_CONFIG_PREFIX=/pgclouddoc/prod/config
# 宿主机调试端口（只绑 127.0.0.1）
ETCD_EXTERNAL_PORT=2379

# ── 管理后台 ──
# 首次启动时把这些邮箱提升为管理员（逗号分隔，只升不降）。
# 流程：先注册账号 → 把邮箱填进来 → 重新部署 → 顶栏出现「配置中心」
ADMIN_EMAILS=1366126256@qq.com

# 镜像源：网络拉不动基础镜像 / npm 包时再打开
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# ETCD_IMAGE=quay.io/coreos/etcd:v3.5.17
# NPM_REGISTRY=https://registry.npmmirror.com
# 构建时用 apt 装 openssl；官方 deb 源超时就换成国内镜像
# APT_MIRROR=mirrors.aliyun.com

# Google OAuth（留空则关闭）
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=https://your.domain/api/v1/auth/oauth/google/callback

# ── AI 助手 ──
# 留空 AI_API_KEY = 功能不可用（插件面板会提示服务端未配置）
# 密钥只存在服务器环境变量里，不要写进插件包或前端
AI_ENABLED=true
AI_PROVIDER=anthropic
AI_BASE_URL=https://api.deepseek.com/anthropic
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_MODELS=deepseek-v4-flash
AI_DAILY_TOKEN_LIMIT=200000
AI_CONTEXT_MAX_CHARS=60000
AI_HISTORY_MAX_CHARS=240000

# 镜像标签，回滚时改成上一个 tag 即可
# IMAGE_TAG=latest
