// PgCloudDoc 数据模型
//
// 约定：
//   1. 表名/列名一律 snake_case（@@map/@map），因为 schema 里还会写裸 SQL
//      （存储过程、视图、compaction），让 SQL 不用到处加引号转义
//   2. 所有 id 用 uuid（应用侧 / DB 侧均可生成），雪花 id 留给将来分库分表
//   3. 软删除用 deletedAt + status，不用物理删 —— 云文档不能一点就没了

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────── 枚举 ──────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

/// 系统级角色。文档权限是 DocumentMember.role，这里是「能不能进管理后台」
enum UserRole {
  USER
  ADMIN
}

/// 事务性发件箱状态
enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// 插件版本状态。
/// v1 上传即发布（只有管理员能上传），保留状态位给后续审核流。
enum PluginVersionStatus {
  UPLOADED
  VALIDATED
  REJECTED
  PUBLISHED
  DEPRECATED
}

/// 插件启用范围。v1 先用 GLOBAL，ROLE/USER 预留给灰度。
enum PluginScope {
  GLOBAL
  ROLE
  USER
}

// ────────────────────────────── 用户 ──────────────────────────────

model User {
  id           String     @id @default(uuid()) @map("id")
  email        String     @unique @map("email")
  username     String     @unique @map("username")
  /// argon2id 哈希。OAuth/OIDC 用户没有密码，为 null
  passwordHash String?    @map("password_hash")
  displayName  String?    @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE) @map("status")
  /// 系统角色：USER 普通用户，ADMIN 可进管理后台（配置中心）
  role         UserRole   @default(USER) @map("role")
  /// JWT 里带上它，改密码/封号时自增即可让所有存量 access token 立刻失效
  tokenVersion Int        @default(0) @map("token_version")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  documents     Document[]
  memberships   DocumentMember[]
  auditLogs     AuditLog[]
  accessRequests DocumentAccessRequest[]
  notifications  Notification[]
  aiConversations AiConversation[]

  @@map("users")
}

/// OAuth2 / OIDC 第三方身份绑定。一个用户可绑多个 provider
model AuthIdentity {
  id             String   @id @default(uuid()) @map("id")
  provider       String   @map("provider")
  providerUserId String   @map("provider_user_id")
  userId         String   @map("user_id")
  email          String?  @map("email")
  /// provider 原始返回，审计用；不参与业务
  raw            Json?    @map("raw")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

/// 刷新令牌。只存 sha256 哈希，明文只在 cookie 里出现一次
model RefreshToken {
  id String @id @default(uuid()) @map("id")
  /// 同一次「登录」产生的一串轮换令牌同属一族，重放检测按族吊销
  familyId     String    @map("family_id")
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// 轮换后指向下一个令牌，链式可追溯
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ip           String?   @map("ip")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ────────────────────────────── 文档 ──────────────────────────────

model Document {
  id          String         @id @default(uuid()) @map("id")
  ownerId     String         @map("owner_id")
  name        String         @map("name")
  description String?        @map("description")
  status      DocumentStatus @default(ACTIVE) @map("status")
  /// materialize 自 Y.Doc 的 IWorkbookData JSON 快照，二进制存减少体积
  snapshot        Bytes?   @map("snapshot")
  snapshotVersion Int      @default(0) @map("snapshot_version")
  /// snapshot 的 sha256，做 ETag / 协商缓存
  contentHash     String?  @map("content_hash")
  docSize         Int      @default(0) @map("doc_size")
  cellCount       Int      @default(0) @map("cell_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members  DocumentMember[]
  updates  DocumentUpdate[]
  versions DocumentVersion[]
  accessRequests DocumentAccessRequest[]
  aiConversations AiConversation[]

  /// 列表页主查询路径：按用户 + 未删除 + 最近更新排序
  @@index([ownerId, status, updatedAt(sort: Desc)])
  @@index([updatedAt])
  @@map("documents")
}

/// 协作者。分享/权限功能预留，本轮只有 OWNER 参与
model DocumentMember {
  id         String     @id @default(uuid()) @map("id")
  documentId String     @map("document_id")
  userId     String     @map("user_id")
  role       MemberRole @default(VIEWER) @map("role")
  createdAt  DateTime   @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
  @@map("document_members")
}

/// Yjs update 追加日志。append-only，定期 compaction 合并
model DocumentUpdate {
  id         BigInt   @id @default(autoincrement()) @map("id")
  documentId String   @map("document_id")
  /// 文档内单调递增序号，重建时按它顺序 applyUpdate
  seq        Int      @map("seq")
  payload    Bytes    @map("payload")
  actorId    String?  @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, seq])
  @@index([documentId, seq])
  @@map("document_updates")
}

/// 存档版本。「存档」的最终落点，可回滚
model DocumentVersion {
  id         String   @id @default(uuid()) @map("id")
  documentId String   @map("document_id")
  versionNo  Int      @map("version_no")
  name       String?  @map("name")
  remark     String?  @map("remark")
  snapshot   Bytes    @map("snapshot")
  sizeBytes  Int      @default(0) @map("size_bytes")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@index([documentId, createdAt(sort: Desc)])
  @@map("document_versions")
}

/// 访问申请。无权限用户请求访问某个文档，由创建者审批
model DocumentAccessRequest {
  id          String              @id @default(uuid()) @map("id")
  documentId  String              @map("document_id")
  requesterId String              @map("requester_id")
  status      AccessRequestStatus @default(PENDING) @map("status")
  decidedBy   String?             @map("decided_by")
  /// 同意时授予的角色（审批时选择只读/编辑）
  decidedRole MemberRole?         @map("decided_role")
  createdAt   DateTime            @default(now()) @map("created_at")
  decidedAt   DateTime?           @map("decided_at")

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requester User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([documentId, status])
  @@index([requesterId, status])
  @@map("document_access_requests")
}

/// 站内消息（左下角弹框）。申请审批、系统通知等统一走这里
model Notification {
  id        String    @id @default(uuid()) @map("id")
  userId    String    @map("user_id")
  type      String    @map("type")
  title     String    @map("title")
  body      String?   @map("body")
  payload   Json?     @map("payload")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ────────────────────────────── 平台 ──────────────────────────────

/// 插件注册表。pluginKey = manifest.id（反向域名）。
model Plugin {
  id          String   @id @default(uuid()) @map("id")
  pluginKey   String   @unique @map("plugin_key")
  name        String
  description String?
  author      String?
  homepage    String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  versions      PluginVersion[]
  installations PluginInstallation[]

  @@map("plugins")
}

/// 不可变版本。同一个 pluginKey + version 只能发布一次。
model PluginVersion {
  id          String              @id @default(uuid()) @map("id")
  pluginId    String              @map("plugin_id")
  version     String
  manifest    Json
  entry       String
  sha256      String
  zipBytes    Int                 @map("zip_bytes")
  assetsBytes Int                 @map("assets_bytes")
  fileCount   Int                 @map("file_count")
  status      PluginVersionStatus @default(VALIDATED)
  pluginApi   String              @map("plugin_api")
  hostRange   String              @map("host_range")
  createdBy   String              @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  publishedAt DateTime?           @map("published_at")
  reviewedBy  String?             @map("reviewed_by")
  reviewNote  String?             @map("review_note")

  plugin        Plugin               @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  installations PluginInstallation[]

  @@unique([pluginId, version])
  @@index([status, publishedAt])
  @@map("plugin_versions")
}

/// 启用关系：当前哪个版本生效。
/// v1 只写 GLOBAL / scopeValue=""；ROLE/USER 预留给灰度和定向测试。
model PluginInstallation {
  id              String      @id @default(uuid()) @map("id")
  pluginId        String      @map("plugin_id")
  pluginVersionId String      @map("plugin_version_id")
  scope           PluginScope @default(GLOBAL)
  scopeValue      String      @default("") @map("scope_value")
  enabled         Boolean     @default(true)
  settings        Json?
  updatedBy       String      @map("updated_by")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  plugin        Plugin        @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  pluginVersion PluginVersion @relation(fields: [pluginVersionId], references: [id], onDelete: Cascade)

  @@unique([pluginId, scope, scopeValue])
  @@map("plugin_installations")
}

model AuditLog {
  id           String   @id @default(uuid()) @map("id")
  /// 来源事件 id：同一条 Kafka 消息重复投递时用于幂等
  eventId      String?  @unique @map("event_id")
  userId       String?  @map("user_id")
  action       String   @map("action")
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ip           String?  @map("ip")
  userAgent    String?  @map("user_agent")
  metadata     Json?    @map("metadata")
  createdAt    DateTime @default(now()) @map("created_at")

  /// 用户注销后审计记录要留着，所以是 SetNull 而不是 Cascade
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// 事务性发件箱：业务写库与 Kafka 发布解耦。
/// Kafka 不可用时事件留在表里，恢复后由 dispatcher 补发，不会丢。
model OutboxEvent {
  id          String       @id @default(uuid()) @map("id")
  topic       String       @map("topic")
  /// 消息 key（通常 documentId / userId），保证同实体事件落同一分区
  eventKey    String?      @map("event_key")
  payload     Json         @map("payload")
  status      OutboxStatus @default(PENDING) @map("status")
  attempts    Int          @default(0) @map("attempts")
  /// 下次可发送时间（失败后的退避）
  availableAt DateTime     @default(now()) @map("available_at")
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at")
  publishedAt DateTime?    @map("published_at")

  @@index([status, availableAt])
  @@index([createdAt])
  @@map("outbox_events")
}

/// Kafka 消费幂等表：(topic, partition, msgOffset) 只处理一次
model ProcessedEvent {
  id          String   @id @default(uuid()) @map("id")
  topic       String   @map("topic")
  partition   Int      @map("partition")
  msgOffset   BigInt   @map("msg_offset")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([topic, partition, msgOffset])
  @@index([processedAt])
  @@map("processed_events")
}

// ────────────────────────────── AI 助手 ──────────────────────────────

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiMessageStatus {
  COMPLETE
  STREAMING
  CANCELLED
  ERROR
  INTERRUPTED
}

/// 一次对话。用户私有；绑定文档时只影响上下文与访问校验，不改变归属。
model AiConversation {
  id         String   @id @default(uuid()) @map("id")
  userId     String   @map("user_id")
  documentId String?  @map("document_id")
  title      String   @default("新对话") @map("title")
  provider   String   @map("provider")
  model      String   @map("model")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  messages AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([documentId])
  @@map("ai_conversations")
}

/// 对话消息。按 seq 升序装配模型上下文。
model AiMessage {
  id             String          @id @default(uuid()) @map("id")
  conversationId String          @map("conversation_id")
  seq            Int             @map("seq")
  role           AiMessageRole   @map("role")
  /// { blocks: AiContentBlock[] }，普通 JSON，不存引擎内部对象
  content        Json            @map("content")
  status         AiMessageStatus @default(COMPLETE) @map("status")
  inputTokens    Int?            @map("input_tokens")
  outputTokens   Int?            @map("output_tokens")
  cachedTokens   Int?            @map("cached_tokens")
  createdAt      DateTime        @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
