# ────────────────────────── 基础 ──────────────────────────
NODE_ENV=development
PORT=3000

# ────────────────────────── PostgreSQL ──────────────────────────
# Prisma 用这条 URL
DATABASE_URL=postgresql://pgclouddoc:pgclouddoc@localhost:5432/pgclouddoc?schema=public
# 连接池（pg.Pool + Prisma driver adapter 显式接管）
PG_HOST=localhost
PG_PORT=5432
PG_USER=pgclouddoc
PG_PASSWORD=pgclouddoc
PG_DB=pgclouddoc
PG_POOL_MAX=20
PG_POOL_MIN=2
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# ────────────────────────── Redis ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Redis 挂掉时是否降级直读 PG（生产建议 true）
REDIS_FAIL_OPEN=true
REDIS_KEY_PREFIX=pgclouddoc:

# ────────────────────────── Kafka ──────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pgclouddoc
KAFKA_CONSUMER_GROUP=pgclouddoc-workers
# 消费者并发数
KAFKA_CONCURRENCY=4
# 重试超过这个次数进死信 topic
KAFKA_MAX_RETRIES=5

# ────────────────────────── 认证 ──────────────────────────
# 生产请用 `openssl rand -base64 48` 重新生成
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=pgclouddoc
JWT_AUDIENCE=pgclouddoc-client
# refresh token 走 cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ────────────────────────── OAuth2 / SSO ──────────────────────────
# 留空则关闭该 provider
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
# 通用 OIDC issuer（SSO 预留）
OIDC_ISSUER=

# ────────────────────────── HTTP ──────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BODY_JSON_LIMIT=1mb
BODY_RAW_LIMIT=8mb
COMPRESSION_THRESHOLD=1024
# 全局限流：窗口内每用户/每 IP 最大请求数
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# ────────────────────────── 日志 ──────────────────────────
LOG_LEVEL=info
# development 下输出彩色单行
LOG_PRETTY=true

# ────────────────────────── 协同 / CRDT ──────────────────────────
# update 日志超过这个行数就触发 compaction
YJS_COMPACT_THRESHOLD=200
# 文档空闲多久后触发一次快照归档（毫秒）
COLLAB_IDLE_SNAPSHOT_MS=30000
# 同一文档两次归档的最小间隔（毫秒）
COLLAB_MIN_SNAPSHOT_INTERVAL_MS=300000
# awareness 心跳过期时间（毫秒）
COLLAB_PRESENCE_TTL_MS=30000

# ────────────────────────── 配置中心（etcd）──────────────────────────
# 留空 = 关闭配置中心（/api/v1/config 返回空配置，管理后台 503）
ETCD_ENDPOINTS=localhost:2379
# 按环境分区：开发用 dev，生产用 prod，避免同一集群互相覆盖
ETCD_CONFIG_PREFIX=/pgclouddoc/dev/config
ETCD_USERNAME=
ETCD_PASSWORD=

# ────────────────────────── 管理后台 ──────────────────────────
# 首次启动时把这些邮箱提升为管理员（逗号分隔，只升不降）
# 先注册账号，再把邮箱填进来重启即可
ADMIN_EMAILS=

# ────────────────────────── 插件 ──────────────────────────
# 插件 zip 与解包产物的根目录；生产挂持久卷
PLUGIN_STORAGE_DIR=./var/plugins

# ────────────────────────── AI 助手 ──────────────────────────
# 总开关；关闭后插件侧面板会提示「服务端已关闭」
AI_ENABLED=true
# anthropic = Anthropic Messages 原生协议；mock = 本地假模型（不调外部服务）
AI_PROVIDER=anthropic
# DeepSeek 的 Anthropic 兼容端点（SDK/适配器自动拼 /v1/messages）
AI_BASE_URL=https://api.deepseek.com/anthropic
# 密钥只放在服务端，永远不要提交进仓库
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
# 可切换的模型白名单（逗号分隔），AI_MODEL 会自动并入
AI_MODELS=deepseek-v4-flash
AI_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT_MS=120000
# 单用户每日 token 上限；0 = 不限制
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_TOOL_CALLS_PER_TURN=8
AI_MAX_STEPS_PER_CONVERSATION=20
# 每轮文档上下文的最大字符数（客户端会先裁剪）
AI_CONTEXT_MAX_CHARS=60000
# 历史消息总字符预算；超出时从最旧的开始丢弃
AI_HISTORY_MAX_CHARS=240000
# 会话保留天数
AI_CONVERSATION_TTL_DAYS=30
