{
  "manifestVersion": 1,
  "id": "com.pgclouddoc.excel-agent",
  "name": "表格内容输出",
  "version": "0.1.0",
  "description": "在工具栏新增按钮，把当前工作簿内容输出到浏览器控制台",
  "author": "PgCloudDoc",
  "entry": "dist/main.js",
  "engines": {
    "pgclouddoc": ">=1.0.0 <2.0.0",
    "pluginApi": "1"
  },
  "activationEvents": ["onCommand:excelAgent.dumpToConsole"],
  "contributes": {
    "commands": [
      {
        "id": "excelAgent.dumpToConsole",
        "title": "输出表格内容到控制台",
        "category": "调试"
      }
    ],
    "toolbar": [
      {
        "slot": "sheet.toolbar.end",
        "command": "excelAgent.dumpToConsole",
        "title": "输出表格",
        "order": 30
      }
    ]
  },
  "permissions": ["document:read"]
}
